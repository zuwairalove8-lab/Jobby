{
  "name": "jobby-browser-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright worker for JOBBY's shared remote browser",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "install-browser": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "^1.65.0"
  }
}
